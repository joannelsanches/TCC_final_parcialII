<%- include('../partials/cabecalho', { titulo: 'Início' }) %>

<section class="hero">
  <div class="hero-background" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div>
      <span class="eyebrow"> IFSul — Campus Bagé </span>

      <h1>
        Seu estágio começa no
        <span>StartIF</span>.
      </h1>

      <p>
        Encontre vagas compatíveis com seu curso, envie seu currículo e acompanhe cada etapa do
        processo seletivo.
      </p>

      <div class="actions">
        <a class="btn btn-secondary" href="/vagas"> Explorar vagas ↗ </a>

        <% if (!usuarioLogado) { %>
        <a class="btn" href="/login"> Entrar </a>

        <a class="btn btn-secondary" href="/cadastro"> Criar conta </a>
        <% } else { %>
        <% const destinoPainel = usuarioLogado.tipo === 'ADMIN' ? '/admin' : usuarioLogado.tipo === 'EMPRESA' ? '/empresa' : '/estudante'; %>
        <a class="btn" href="<%= destinoPainel %>"> Acessar meu painel </a>
        <% } %>
      </div>
    </div>

    <div class="hero-art" aria-label="Acompanhe seu estágio em um só lugar">
      <div class="journey-card">
        <span class="eyebrow">Um passo de cada vez</span>
        <h3>O seu futuro<br />ganha espaço.</h3>
        <div class="journey-step">
          <span aria-hidden="true">01</span>
          <div>
            <strong>Encontre sua oportunidade</strong><small>Vagas compatíveis com seu curso</small>
          </div>
        </div>
        <div class="journey-step">
          <span aria-hidden="true">02</span>
          <div>
            <strong>Mostre seu potencial</strong
            ><small>Currículo e candidaturas num só lugar</small>
          </div>
        </div>
        <div class="journey-step">
          <span aria-hidden="true">03</span>
          <div>
            <strong>Acompanhe seu estágio</strong
            ><small>Documentos, termos e próximos passos</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container container-wide">
    <div class="metrics">
      <div class="metric">
        <strong><%= vagas.length %></strong>
        <span>vagas recentes</span>
      </div>

      <div class="metric">
        <strong><%= estudantes %></strong>
        <span>estudantes</span>
      </div>

      <div class="metric">
        <strong><%= empresas %></strong>
        <span>empresas</span>
      </div>
    </div>

    <div class="section-heading section-offset">
      <div>
        <h2>Oportunidades recentes</h2>

        <p class="muted">Vagas abertas e dentro do prazo.</p>
      </div>

      <a href="/vagas"> Ver todas → </a>
    </div>

    <div class="jobs-grid">
      <% vagas.forEach(vaga => { %>
      <%- include('../partials/vaga-card', { vaga }) %>
      <% }) %>
    </div>

    <% if (!vagas.length) { %>

    <div class="empty">Nenhuma vaga aberta no momento.</div>

    <% } %>
  </div>
</section>

<%- include('../partials/rodape') %>
