<%- include('../partials/cabecalho', { titulo: 'Áreas de atuação' }) %>
<%
  const preenchido = Object.keys(valores || {}).length > 0;
  const nomeAtual = preenchido ? (valores.nome || '') : (edicao?.nome || '');
  const ativoMarcado = preenchido ? valores.ativo === 'on' : (edicao ? edicao.ativo : true);
%>

<section class="section">
  <div class="container">
    <a class="back-link" href="/admin/cadastros">← Cadastros institucionais</a>
    <div class="page-header page-header-left">
      <span class="eyebrow">Cadastro institucional</span>
      <h1>Áreas de atuação</h1>
      <p class="muted">
        Áreas inativas permanecem nos registros antigos, mas não aparecem em novos cursos e vagas.
      </p>
    </div>

    <div class="card form-card">
      <h2><%= edicao ? 'Editar área' : 'Nova área' %></h2>
      <% if (erros?.geral) { %>
      <div class="alert erro" role="alert"><%= erros.geral %></div>
      <% } %>
      <form class="form-grid compact-form" method="post" action="<%= edicao ? `/admin/areas/${edicao._id}/editar` : '/admin/areas' %>">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <div class="field <%= erros?.nome ? 'field-invalid' : '' %>">
          <label for="nome">Nome *</label>
          <input
            id="nome"
            name="nome"
            value="<%= nomeAtual %>"
            required
            aria-invalid="<%= erros?.nome ? 'true' : 'false' %>"
          /><% if (erros?.nome) { %><small class="field-error"><%= erros.nome %></small
          ><% } %>
        </div>
        <label class="check-card"
          ><input type="checkbox" name="ativo" <%= ativoMarcado ? 'checked' : '' %> /><span
            >Área ativa</span
          ></label
        >
        <div class="field full form-actions">
          <button class="btn"><%= edicao ? 'Salvar área' : 'Cadastrar área' %></button
          ><% if (edicao) { %><a class="btn btn-secondary" href="/admin/areas"
            >Cancelar</a
          ><% } %>
        </div>
      </form>
    </div>

    <div class="record-list spaced">
      <% areas.forEach((area) => { %>
      <article class="record-row">
        <div><strong><%= area.nome %></strong><small>Área de atuação</small></div>
        <span class="badge <%= area.ativo ? 'ativo' : 'inativo' %>"><%= area.ativo ? 'Ativa' : 'Inativa' %></span>
        <div class="actions table-actions">
          <a class="btn btn-small btn-secondary" href="/admin/areas/<%= area._id %>/editar"
            >Editar</a
          >
          <form method="post" action="/admin/cadastros/area/<%= area._id %>/alternar">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" /><button
              class="btn btn-small btn-secondary"
            >
              <%= area.ativo ? 'Desativar' : 'Ativar' %>
            </button>
          </form>
          <form
            method="post"
            action="/admin/cadastros/area/<%= area._id %>/excluir"
            data-confirmar="Excluir esta área permanentemente?"
          >
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" /><button
              class="btn btn-small btn-danger"
            >
              Excluir
            </button>
          </form>
        </div>
      </article>
      <% }) %>
      <% if (!areas.length) { %>
      <div class="empty">Nenhuma área cadastrada.</div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/rodape') %>
