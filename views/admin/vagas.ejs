<%- include('../partials/cabecalho', { titulo: 'Validação de vagas' }) %>

<section class="section">
  <div class="container">
    <div class="page-header">
      <h1>Validação de vagas</h1>
      <p class="muted">Verifique a compatibilidade com os cursos e o PPC antes da publicação.</p>
    </div>

    <form method="get" class="card form-grid compact-form" action="/admin/vagas">
      <div class="field">
        <label for="status-vagas">Situação</label
        ><select id="status-vagas" name="status">
          <% ['PENDENTE_VALIDACAO','ABERTA','FECHADA','ARQUIVADA','CANCELADA','REPROVADA','RASCUNHO'].forEach(item => { %>
          <option value="<%= item %>" <%= typeof status !== 'undefined' && status === item ? 'selected' : '' %>>
            <%= item.replaceAll('_',' ') %>
          </option>
          <% }) %>
        </select>
      </div>
      <button class="btn">Filtrar vagas</button>
    </form>
    <div class="stack">
      <% vagas.forEach(v => { %>
      <article class="card">
        <div class="section-heading">
          <div>
            <span class="tag"> <%= v.areaAtuacao?.nome %> </span>

            <h2><%= v.titulo %></h2>

            <p>
              <strong><%= formatarNomeProprio(v.empresa?.nomeFantasia) %></strong>
              · <%= v.modalidade === 'REMOTO' ? 'Remoto' : formatarEndereco(v.localizacao, v.localizacaoAntiga) %>
            </p>
          </div>

          <span class="badge <%= v.status.toLowerCase() %>"> <%= v.status.replaceAll('_',' ') %> </span>
        </div>

        <p>
          <strong>Descrição:</strong>
          <%= v.descricao %>
        </p>

        <p>
          <strong>Requisitos:</strong>
          <%= v.requisitos %>
        </p>
        <p>
          <strong>Atividades:</strong>
          <%= v.atividades || 'Não especificadas' %>
        </p>

        <p>
          <strong>Cursos:</strong>
          <%= v.cursosCompativeis.map(c => c.nome).join(', ') %>
        </p>

        <p>
          <strong>Bolsa/carga:</strong>
          <%= formatarMoeda(v.bolsa) %> · <%= v.cargaHorariaDiaria || '—' %>h/dia · <%= v.cargaHorariaSemanal || v.cargaHoraria %>h/semana
        </p>

        <p>
          <strong>Período/modalidade:</strong> <%= formatarData(v.periodoInicio) %> a <%= formatarData(v.periodoFim) %> ·
          <%= v.modalidadeEstagio?.replaceAll('_',' ') %> · <%= v.modalidade %>
        </p>
        <p><strong>Supervisor:</strong> <%= formatarNomeProprio(v.supervisor?.nome || '—') %> · <%= v.supervisor?.formacao || v.supervisor?.experiencia || 'formação/experiência não informada' %></p>

        <% if (v.status === 'PENDENTE_VALIDACAO') { %>
        <form method="post" action="/admin/vagas/<%= v._id %>/validar" class="form-grid">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

          <div class="field full">
            <label>Justificativa ou observação</label>

            <textarea name="justificativa"><%= v.justificativaValidacao || '' %></textarea>
          </div>

          <button class="btn" name="decisao" value="aprovar">Aprovar vaga</button>

          <button class="btn btn-danger" name="decisao" value="reprovar">Reprovar vaga</button>
        </form>
        <% } %>
        <% if (!v.arquivada && typeof podeGerenciarExclusoes !== 'undefined' && podeGerenciarExclusoes) { %>
        <form
          method="post"
          action="/admin/vagas/<%= v._id %>/excluir"
          data-confirmar="Excluir a vaga? Processos existentes serão preservados por arquivamento."
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button
            class="btn btn-danger"
          >
            Excluir vaga
          </button>
        </form>
        <% } %>
      </article>
      <% }) %>
    </div>

    <% if (!vagas.length) { %>
    <div class="empty">Não há vagas nesta situação.</div>
    <% } %>
  </div>
</section>

<%- include('../partials/rodape') %>
