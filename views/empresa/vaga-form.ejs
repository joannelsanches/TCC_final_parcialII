<%- include('../partials/cabecalho', { titulo: vaga ? 'Editar vaga' : 'Nova vaga' }) %>
<% const dataCampo = (data) => data ? new Date(data).toISOString().slice(0,10) : ''; %>
<%
  const valorInformado = typeof valores !== 'undefined' && valores ? valores : {};
  const campo = (nome, atual = '') => Object.prototype.hasOwnProperty.call(valorInformado, nome) ? valorInformado[nome] : (atual ?? '');
  const marcado = (nome, valor, atuais = []) => {
    const informados = Object.prototype.hasOwnProperty.call(valorInformado, nome) ? (Array.isArray(valorInformado[nome]) ? valorInformado[nome] : [valorInformado[nome]]) : atuais;
    return informados.map(String).includes(String(valor));
  };
  const formularioReenviado = Object.keys(valorInformado).length > 0;
  const modalidadeAtual = campo('modalidade', vaga?.modalidade || 'PRESENCIAL');
%>

<section class="section">
  <div class="container">
    <div class="page-header">
      <h1><%= vaga ? 'Editar vaga' : 'Publicar nova vaga' %></h1>
      <p class="muted">
        A criação, edição ou reenvio passa por validação institucional antes da publicação.
      </p>
    </div>
    <div class="card form-card">
      <% if (erros?.geral) { %>
      <div class="alert erro" role="alert"><%= erros.geral %></div>
      <% } %>
      <form method="post" enctype="multipart/form-data" class="form-grid" data-vaga-form>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <div class="field full form-section-title"><h2>Apresentação</h2></div>
        <div class="field full <%= erros?.titulo ? 'field-invalid' : '' %>">
          <label for="titulo">Título *</label>
          <input
            id="titulo"
            name="titulo"
            value="<%= campo('titulo', vaga?.titulo) %>"
            required
            aria-invalid="<%= erros?.titulo ? 'true' : 'false' %>"
          /><% if (erros?.titulo) { %><small class="field-error"><%= erros.titulo %></small
          ><% } %>
        </div>
        <div class="field full <%= erros?.descricao ? 'field-invalid' : '' %>">
          <label for="descricao">Descrição pública *</label
          ><textarea
            id="descricao"
            name="descricao"
            required
            aria-invalid="<%= erros?.descricao ? 'true' : 'false' %>"
          >
<%= campo('descricao', vaga?.descricao) %></textarea
          ><% if (erros?.descricao) { %><small class="field-error"><%= erros.descricao %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.areaAtuacao ? 'field-invalid' : '' %>">
          <label for="areaAtuacao">Área de atuação *</label
          ><select
            id="areaAtuacao"
            name="areaAtuacao"
            required
            aria-invalid="<%= erros?.areaAtuacao ? 'true' : 'false' %>"
          >
            <option value="">Selecione</option>
            <% areas.forEach(a => { %>
            <option value="<%= a._id %>" <%= String(campo('areaAtuacao', vaga?.areaAtuacao)) === String(a._id) ? 'selected' : '' %>>
              <%= a.nome %>
            </option>
            <% }) %></select
          ><% if (erros?.areaAtuacao) { %><small class="field-error"><%= erros.areaAtuacao %></small
          ><% } %>
        </div>
        <div class="field campus-fixed">
          <span class="field-label">Instituição</span><strong>IFSul — Campus Bagé</strong>
        </div>
        <div class="field full image-field">
          <label>Imagem da vaga (opcional)</label>
          <% if (vaga?.imagem?.caminho) { %><img
            class="vacancy-form-image"
            src="/midia/vagas/<%= vaga._id %>/imagem"
            alt="Imagem atual da vaga"
          /><% } %>
          <div class="image-preview image-preview-wide" data-preview-box hidden>
            <img alt="Pré-visualização da nova imagem" data-preview-image />
          </div>
          <input
            type="file"
            name="imagem"
            accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
            data-image-input
            data-preview-target="[data-preview-image]"
          />
          <small class="help"
            >Se nenhum arquivo for escolhido, a imagem atual será preservada.</small
          >
        </div>

        <div class="field full form-section-title"><h2>Estágio e atividades</h2></div>
        <div class="field">
          <label>Modalidade do estágio *</label
          ><select name="modalidadeEstagio" required>
            <option value="NAO_OBRIGATORIO" <%= campo('modalidadeEstagio', vaga?.modalidadeEstagio || 'NAO_OBRIGATORIO') === 'NAO_OBRIGATORIO' ? 'selected' : '' %>>Não obrigatório</option>
            <option value="OBRIGATORIO" <%= campo('modalidadeEstagio', vaga?.modalidadeEstagio) === 'OBRIGATORIO' ? 'selected' : '' %>>Obrigatório</option>
          </select>
        </div>
        <div class="field">
          <label for="empresa-vaga-form-modalidade-0">Forma de trabalho *</label
          ><select id="empresa-vaga-form-modalidade-0" name="modalidade" required data-modalidade>
            <% ['PRESENCIAL','HIBRIDO','REMOTO'].forEach(m => { %>
            <option value="<%= m %>" <%= modalidadeAtual === m ? 'selected' : '' %>>
              <%= m %>
            </option>
            <% }) %>
          </select>
        </div>
        <div class="field full <%= erros?.atividades ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-atividades-1">Atividades que serão desenvolvidas *</label
          ><textarea id="empresa-vaga-form-atividades-1" name="atividades" required aria-invalid="<%= erros?.atividades ? 'true' : 'false' %>">
<%= campo('atividades', vaga?.atividades) %></textarea
          ><% if (erros?.atividades) { %><small class="field-error"><%= erros.atividades %></small
          ><% } %>
        </div>
        <div class="field full <%= erros?.requisitos ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-requisitos-2">Requisitos para candidatura *</label
          ><textarea id="empresa-vaga-form-requisitos-2" name="requisitos" required aria-invalid="<%= erros?.requisitos ? 'true' : 'false' %>">
<%= campo('requisitos', vaga?.requisitos) %></textarea
          ><% if (erros?.requisitos) { %><small class="field-error"><%= erros.requisitos %></small
          ><% } %>
        </div>
        <div class="field full">
          <label for="empresa-vaga-form-requisitosAcademicos-3">Requisitos acadêmicos</label
          ><textarea id="empresa-vaga-form-requisitosAcademicos-3" name="requisitosAcademicos"><%= campo('requisitosAcademicos', vaga?.requisitosAcademicos) %></textarea>
        </div>
        <div class="field full">
          <label for="empresa-vaga-form-documentosObrigatorios-4">Documentos solicitados</label>
          <input id="empresa-vaga-form-documentosObrigatorios-4" name="documentosObrigatorios" value="<%= campo('documentosObrigatorios', vaga?.documentosObrigatorios?.join(', ')) %>" /><small
            class="help"
            >Separe por vírgulas. Estes documentos não substituem os anexos do termo.</small
          >
        </div>
        <div class="field full <%= erros?.cursosCompativeis ? 'field-invalid' : '' %>">
          <label>Cursos compatíveis *</label>
          <div class="check-grid">
            <% cursos.forEach(c => { %><label class="check-card"
              ><input
                type="checkbox"
                name="cursosCompativeis"
                value="<%= c._id %>"
                <%= marcado('cursosCompativeis', c._id, vaga?.cursosCompativeis || []) ? 'checked' : '' %>
                data-group-required="cursos"
              /><span><%= c.nome %><small><%= c.campus?.nome %></small></span></label
            ><% }) %>
          </div>
          <% if (erros?.cursosCompativeis) { %><small class="field-error"><%= erros.cursosCompativeis %></small
          ><% } %>
        </div>

        <div class="field full form-section-title"><h2>Jornada e período</h2></div>
        <div class="field <%= erros?.cargaHorariaDiaria ? 'field-invalid' : '' %>">
          <label>Carga diária *</label>
          <input
            name="cargaHorariaDiaria"
            type="number"
            min="1"
            max="8"
            value="<%= campo('cargaHorariaDiaria', vaga?.cargaHorariaDiaria) %>"
            required
            aria-invalid="<%= erros?.cargaHorariaDiaria ? 'true' : 'false' %>"
          /><small class="help"
            >Acima de 6h somente quando a regra do curso/PPC permitir jornada de 40h.</small
          ><% if (erros?.cargaHorariaDiaria) { %><small class="field-error"><%= erros.cargaHorariaDiaria %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.cargaHorariaSemanal ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-cargaHorariaSemanal-5">Carga semanal *</label>
          <input id="empresa-vaga-form-cargaHorariaSemanal-5"
            name="cargaHorariaSemanal"
            type="number"
            min="1"
            max="40"
            value="<%= campo('cargaHorariaSemanal', vaga?.cargaHorariaSemanal || vaga?.cargaHoraria) %>"
            required
            aria-invalid="<%= erros?.cargaHorariaSemanal ? 'true' : 'false' %>"
          /><% if (erros?.cargaHorariaSemanal) { %><small class="field-error"><%= erros.cargaHorariaSemanal %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.horarioInicio ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-horarioInicio-6">Horário inicial *</label>
          <input id="empresa-vaga-form-horarioInicio-6"
            name="horarioInicio"
            type="time"
            value="<%= campo('horarioInicio', vaga?.horarioInicio) %>"
            required
            aria-invalid="<%= erros?.horarioInicio ? 'true' : 'false' %>"
          /><% if (erros?.horarioInicio) { %><small class="field-error"><%= erros.horarioInicio %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.horarioFim ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-horarioFim-7">Horário final *</label>
          <input id="empresa-vaga-form-horarioFim-7"
            name="horarioFim"
            type="time"
            value="<%= campo('horarioFim', vaga?.horarioFim) %>"
            required
            aria-invalid="<%= erros?.horarioFim ? 'true' : 'false' %>"
          /><% if (erros?.horarioFim) { %><small class="field-error"><%= erros.horarioFim %></small
          ><% } %>
        </div>
        <div class="field">
          <label for="empresa-vaga-form-intervalo-8">Intervalo</label>
          <input id="empresa-vaga-form-intervalo-8" name="intervalo" placeholder="Ex.: 12h às 13h" value="<%= campo('intervalo', vaga?.intervalo) %>" />
        </div>
        <div class="field <%= erros?.quantidadeVagas ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-quantidadeVagas-9">Quantidade de vagas *</label>
          <input id="empresa-vaga-form-quantidadeVagas-9"
            name="quantidadeVagas"
            type="number"
            min="1"
            value="<%= campo('quantidadeVagas', vaga?.quantidadeVagas || 1) %>"
            required
            aria-invalid="<%= erros?.quantidadeVagas ? 'true' : 'false' %>"
          /><% if (erros?.quantidadeVagas) { %><small class="field-error"><%= erros.quantidadeVagas %></small
          ><% } %>
        </div>
        <div class="field full <%= erros?.diasSemana ? 'field-invalid' : '' %>">
          <label>Dias da semana *</label>
          <div class="check-grid compact">
            <% [['SEGUNDA','Segunda'],['TERCA','Terça'],['QUARTA','Quarta'],['QUINTA','Quinta'],['SEXTA','Sexta'],['SABADO','Sábado']].forEach(([valor,rotulo]) => { %><label class="check-card"
              ><input
                type="checkbox"
                name="diasSemana"
                value="<%= valor %>"
                <%= marcado('diasSemana', valor, vaga?.diasSemana || []) ? 'checked' : '' %>
                data-group-required="dias"
              /><span><%= rotulo %></span></label
            ><% }) %>
          </div>
          <% if (erros?.diasSemana) { %><small class="field-error"><%= erros.diasSemana %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.periodoInicio ? 'field-invalid' : '' %>">
          <label>Início previsto *</label>
          <input
            name="periodoInicio"
            type="date"
            value="<%= campo('periodoInicio', dataCampo(vaga?.periodoInicio)) %>"
            required
            aria-invalid="<%= erros?.periodoInicio ? 'true' : 'false' %>"
          /><% if (erros?.periodoInicio) { %><small class="field-error"><%= erros.periodoInicio %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.periodoFim ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-periodoFim-10">Fim previsto *</label>
          <input id="empresa-vaga-form-periodoFim-10"
            name="periodoFim"
            type="date"
            value="<%= campo('periodoFim', dataCampo(vaga?.periodoFim)) %>"
            required
            aria-invalid="<%= erros?.periodoFim ? 'true' : 'false' %>"
          /><% if (erros?.periodoFim) { %><small class="field-error"><%= erros.periodoFim %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.prazo ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-prazo-11">Prazo para candidatura *</label>
          <input id="empresa-vaga-form-prazo-11"
            name="prazo"
            type="date"
            value="<%= campo('prazo', dataCampo(vaga?.prazo)) %>"
            required
            aria-invalid="<%= erros?.prazo ? 'true' : 'false' %>"
          /><% if (erros?.prazo) { %><small class="field-error"><%= erros.prazo %></small
          ><% } %>
        </div>
        <label class="check-card field"
          ><input type="checkbox" name="reducaoJornadaAvaliacoes" <%= (formularioReenviado ? campo('reducaoJornadaAvaliacoes') === 'on' : vaga?.reducaoJornadaAvaliacoes !== false) ? 'checked' : '' %> /><span
            >Redução de jornada pelo menos à metade em avaliações</span
          ></label
        >

        <div class="field full form-section-title"><h2>Bolsa e benefícios</h2></div>
        <div class="field <%= erros?.bolsa ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-bolsa-12">Bolsa-auxílio (R$) *</label>
          <input id="empresa-vaga-form-bolsa-12"
            name="bolsa"
            type="number"
            min="0"
            step="0.01"
            value="<%= campo('bolsa', vaga?.bolsa) %>"
            required
            aria-invalid="<%= erros?.bolsa ? 'true' : 'false' %>"
          /><% if (erros?.bolsa) { %><small class="field-error"><%= erros.bolsa %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.auxilioTransporte ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-auxilioTransporte-13">Auxílio-transporte (R$) *</label>
          <input id="empresa-vaga-form-auxilioTransporte-13"
            name="auxilioTransporte"
            type="number"
            min="0"
            step="0.01"
            value="<%= campo('auxilioTransporte', vaga?.auxilioTransporte) %>"
            required
            aria-invalid="<%= erros?.auxilioTransporte ? 'true' : 'false' %>"
          /><% if (erros?.auxilioTransporte) { %><small class="field-error"><%= erros.auxilioTransporte %></small
          ><% } %>
        </div>
        <div class="field full">
          <label for="empresa-vaga-form-outrosBeneficios-14">Outros benefícios</label>
          <input id="empresa-vaga-form-outrosBeneficios-14" name="outrosBeneficios" value="<%= campo('outrosBeneficios', vaga?.outrosBeneficios) %>" />
        </div>

        <div class="field full form-section-title"><h2>Supervisor da empresa</h2></div>
        <div class="field <%= erros?.supervisorNome ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-supervisorNome-15">Nome *</label>
          <input id="empresa-vaga-form-supervisorNome-15"
            name="supervisorNome"
            value="<%= campo('supervisorNome', vaga?.supervisor?.nome) %>"
            required
            aria-invalid="<%= erros?.supervisorNome ? 'true' : 'false' %>"
          /><% if (erros?.supervisorNome) { %><small class="field-error"><%= erros.supervisorNome %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.supervisorCargo ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-supervisorCargo-16">Cargo *</label>
          <input id="empresa-vaga-form-supervisorCargo-16"
            name="supervisorCargo"
            value="<%= campo('supervisorCargo', vaga?.supervisor?.cargo) %>"
            required
            aria-invalid="<%= erros?.supervisorCargo ? 'true' : 'false' %>"
          /><% if (erros?.supervisorCargo) { %><small class="field-error"><%= erros.supervisorCargo %></small
          ><% } %>
        </div>
        <div class="field <%= erros?.supervisorFormacao ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-supervisorFormacao-17">Formação</label>
          <input id="empresa-vaga-form-supervisorFormacao-17"
            name="supervisorFormacao"
            value="<%= campo('supervisorFormacao', vaga?.supervisor?.formacao) %>"
            aria-invalid="<%= erros?.supervisorFormacao ? 'true' : 'false' %>"
          /><% if (erros?.supervisorFormacao) { %><small class="field-error"><%= erros.supervisorFormacao %></small
          ><% } %>
        </div>
        <div class="field">
          <label for="empresa-vaga-form-supervisorExperiencia-18">Experiência na área</label>
          <input id="empresa-vaga-form-supervisorExperiencia-18" name="supervisorExperiencia" value="<%= campo('supervisorExperiencia', vaga?.supervisor?.experiencia) %>" />
        </div>
        <div class="field">
          <label for="empresa-vaga-form-supervisorEmail-19">E-mail</label>
          <input id="empresa-vaga-form-supervisorEmail-19" name="supervisorEmail" type="email" value="<%= campo('supervisorEmail', vaga?.supervisor?.email) %>" />
        </div>
        <div class="field">
          <label for="empresa-vaga-form-supervisorTelefone-20">Telefone</label><input id="empresa-vaga-form-supervisorTelefone-20" name="supervisorTelefone" value="<%= campo('supervisorTelefone', vaga?.supervisor?.telefone) %>" />
        </div>
        <div class="field <%= erros?.supervisorQuantidadeAtual ? 'field-invalid' : '' %>">
          <label for="empresa-vaga-form-supervisorQuantidadeAtual-21">Estagiários já acompanhados *</label>
          <input id="empresa-vaga-form-supervisorQuantidadeAtual-21"
            name="supervisorQuantidadeAtual"
            type="number"
            min="0"
            max="10"
            value="<%= campo('supervisorQuantidadeAtual', vaga?.supervisor?.quantidadeEstagiariosAtuais || 0) %>"
            required
            aria-invalid="<%= erros?.supervisorQuantidadeAtual ? 'true' : 'false' %>"
          /><% if (erros?.supervisorQuantidadeAtual) { %><small class="field-error"><%= erros.supervisorQuantidadeAtual %></small
          ><% } %>
        </div>

        <div class="address-fields full" data-address-fields>
          <div class="form-grid"><%- include('../partials/campos-endereco', { prefixo: 'localizacao', valor: vaga?.localizacao, obrigatorio: modalidadeAtual !== 'REMOTO', tituloEndereco: 'Localização da vaga', ajudaEndereco: 'Obrigatória para vagas presenciais e híbridas.' }) %></div>
        </div>

        <div class="field full form-actions">
          <% if (!vaga || ['RASCUNHO','REPROVADA'].includes(vaga.status)) { %><button
            class="btn btn-secondary"
            type="submit"
            name="acao"
            value="rascunho"
            formnovalidate
          >
            Salvar como rascunho</button
          ><% } %>
          <button class="btn" type="submit" name="acao" value="enviar">
            <%= vaga?.status === 'REPROVADA' ? 'Editar e reenviar' : 'Enviar para validação' %>
          </button>
        </div>
      </form>
      <% if (vaga?.imagem?.caminho) { %>
      <form
        method="post"
        action="/empresa/vagas/<%= vaga._id %>/imagem/remover"
        data-confirmar="Remover a imagem atual da vaga?"
        class="separate-action"
      >
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" /><button
          class="btn btn-danger"
        >
          Remover imagem
        </button>
      </form>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/rodape') %>
